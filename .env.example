# 复制为 .env 后填入密钥。.env 已在 .gitignore 中。
# 也可以把这些变量写进 /etc/xiaomeng.env 由 systemd 加载。

# 只需要这一个 key：对话和联网搜索都用它
# （search.provider = "deepseek"，调用 POST /v1/tools/search，按次计费）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：换用其它搜索供应商时才需要
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
# SEARXNG_URL=http://127.0.0.1:8080

RUST_LOG=info
