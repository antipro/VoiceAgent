# 复制为 .env 后填入密钥。.env 已在 .gitignore 中。
# 也可以把这些变量写进 /etc/xiaomeng.env 由 systemd 加载。

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 使用 tavily 搜索时必填；改用 searxng 可以留空。
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
# 自建 SearXNG（search.provider = "searxng" 时使用）
# SEARXNG_URL=http://127.0.0.1:8080

RUST_LOG=info
